# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!deploy/.env.production.example
!deploy/.env.customer.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable design skill — local tool, regenerable via `npx impeccable skills install`
.claude/
.cursor/
.agents/
skills-lock.json

# i18n translation working file (regenerate with pnpm i18n:export)
messages/*.csv

# Consultant-supplied feedback workbook (kept locally, not part of the repo)
AI-HR-Consultant-Feedback-Template.xlsx

# improvement-loop runtime (logs, patches) — local only
.improve/

# Clean-room gate receipt (local, per-machine — consumed by improve:release to skip a duplicate suite run)
.gate-receipt.json

# Vitest browser mode: failure screenshots and attachments are run artifacts, not sources.
test/__screenshots__/
.vitest-attachments/

# graphify code graph — local, regenerable (`graphify extract . --code-only`), ~16 MB; never commit or deploy
graphify-out/

# Build-agent evidence (screenshots, measurement JSON, dev logs). A render check produces megabytes
# of it and r374 found this directory UNIGNORED, one `git add -A` away from a 4 MB commit.
scratchpad/
