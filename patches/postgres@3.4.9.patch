@@ -780,6 +780,14 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     types.forEach(({ oid, typarray }) => addArrayType(oid, typarray))
   }
 
+  // ai-hr patch (patches/README.md). Nothing awaited the type fetch, so its failure was an unhandled
+  // rejection; a pooler refusing a new connection's first query (PgBouncer query_wait_timeout) ended
+  // a plain Node process. errored() has already failed the waiting query with the same error. Close
+  // the connection so it never runs without array types; the next connection fetches them again.
+  function fetchArrayTypesFailed() {
+    socket && socket.readyState === 'open' && socket.end(b().X().end())
+  }
+
   function addArrayType(oid, typarray) {
     if (!!options.parsers[typarray] && !!options.serializers[typarray]) return
     const parser = options.parsers[oid]
