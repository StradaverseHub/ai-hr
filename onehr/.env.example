# OneHR environment variables. Names only; set the values yourself and never commit a real .env file.
# Every variable is optional for a local run unless noted.

# --- Core ---
# Signs the session cookie. Required (32+ random characters) when L360_PROD=1.
SECRET_KEY=
# Set to 1 for a server that real people use (enables secure cookies and the SECRET_KEY check).
L360_PROD=
# Set to 1 to run the Flask debug server locally.
FLASK_DEBUG=
# Folder that holds leadership360.db (default: the app folder).
ONEHR_DATA_DIR=
# Public base URL used in email links (default: a local address, or a placeholder when L360_PROD=1).
APP_BASE_URL=
# Where import backups are written (default: an import-backups folder beside the database).
L360_IMPORT_BACKUP_DIR=
# Set to 1 to boot even if the start-up schema migration fails (not recommended).
L360_ALLOW_SCHEMA_FAILURE=
# A build identifier shown to the AI+ Connect admin tool.
ONEHR_COMMIT=

# --- Demo switches (never on a real server) ---
L360_DEMO_ACCOUNTS=
L360_DEMO_ADMIN=

# --- Feature switches (1 = on) ---
ONEHR_GRADEH=
ONEHR_LMS=
ONEHR_DASH2=
ONEHR_CHAIR=
ONEHR_COA=
ONEHR_EC_PA=
ONEHR_ONBOARDING=
ONEHR_MCP=
ONEHR_PRERUN=
ONEHR_PRERUN_CONCURRENCY=

# --- AI (Azure OpenAI primary) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENT_EC=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_REASONING=
AZURE_OPENAI_REASONING_EFFORT=
AZURE_OPENAI_SUMMARY_EFFORT=
ONEHR_AI_DEADLINE_S=
REVIEW_AGENT_CLI=

# --- AI (OpenAI backup) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_BACKUP_MODEL=

# --- Email (Microsoft Graph, optional; without these the app sends no email) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# --- File storage for performance attachments (optional; default is local disk) ---
PM_BLOB_ACCOUNT_NAME=
PM_BLOB_CONTAINER=
