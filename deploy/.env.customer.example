# AI HR — production env for a CUSTOMER deployment. Copy to `.env.production` (git-ignored) and fill in.
# Generate secrets with:  openssl rand -base64 32
#
# THIS IS NOT deploy/.env.production.example. That file is the GATED CONSULTANT DEMO's template and it
# carries ALLOW_DEMO_SESSION / DEV_TENANT_ID / DEV_USER_ID. Those three variables are what let
# `deploy/deploy.sh` run `db/seed.ts`, which TRUNCATEs 24 tables and plants a fictional "Demo Group"
# tenant. A customer deployment must not contain them — their ABSENCE is what makes the demo seeder
# refuse (db/seed-guard.ts) and what makes a plain `./deploy/deploy.sh` skip the seed entirely.
#
# Deploy with:  ./deploy/deploy-customer.sh      (see deploy/DEPLOY.md, "Deploying for a customer")
# The deploy refuses placeholders, missing auth, disabled audit chaining and demo identities BEFORE
# installing dependencies, building or migrating. This also applies to --migrate-only. Keep .env,
# .env.local and .env.production.local out of the customer release directory: Next reads them too.
# Customer builds and runtime require Node.js 22 or newer; use the pinned /opt/node22/bin toolchain.

NODE_ENV=production

# App DB role — non-privileged, RLS-enforced (this is what the running app uses):
# For a separate private-cloud database, replace localhost with its private DNS name and append
# ?sslmode=verify-full to BOTH URLs. Plaintext/require/prefer remote connections are refused.
# Trust an internal CA via NODE_EXTRA_CA_CERTS=/etc/ssl/certs/aihr-database-ca.pem (read-only).
# postgres.js uses Node's CA trust; PGSSLROOTCERT belongs to libpq backup clients, not the app.
DATABASE_URL=postgresql://ai_hr_app:CHANGE_ME_APP_PW@localhost:5432/ai_hr

# Owner role — runs migrations only on this path (used by deploy-customer.sh, NOT the running app):
MIGRATION_DATABASE_URL=postgresql://ai_hr_owner:CHANGE_ME_OWNER_PW@localhost:5432/ai_hr

# Secret for encrypting in-app AI provider keys at rest (min 16 chars; keep stable or stored keys break):
AI_CONFIG_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# ADR-0030 tamper-evidence. SET THIS BEFORE THE FIRST REAL RECORD IS LOADED — there is no backfill, and
# every domain_event written while it is off is permanently unchained (readiness 1.2).
AUDIT_HASH_CHAIN_ENABLED=true

# HTTP-Basic holding gate (at least 16 characters). It is still required alongside WorkOS: removing
# this value refuses deployment and serving. Retiring the gate requires a reviewed middleware change.
SHARE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Real authentication is required BEFORE the first customer deployment, including --migrate-only.
# Provision credentials in WorkOS and register the identical HTTPS /callback URI there. Generating
# keys does not need an existing app tenant/admin. Generate a separate 32+ character cookie password.
# A passing configuration check does not verify provider credentials or prove anyone can sign in;
# complete tenant/operator provisioning and verify a real login before loading sensitive data.
WORKOS_API_KEY=CHANGE_ME_WORKOS_API_KEY
WORKOS_CLIENT_ID=CHANGE_ME_WORKOS_CLIENT_ID
WORKOS_COOKIE_PASSWORD=CHANGE_ME_SEPARATE_32_CHARACTER_SECRET
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://CHANGE_ME_CUSTOMER_HOST/callback

# Port the app binds on (put it behind nginx or a named tunnel — readiness 1.8):
PORT=3000

# DELIBERATELY ABSENT, and do not copy them in from the demo template:
#   ALLOW_DEMO_SESSION  — turns on the "act as" switcher; a deployment with it on authenticates nobody.
#   DEV_TENANT_ID       — the demo tenant's id; only deploy.sh's demo branch reads it.
#   DEV_USER_ID         — the demo HR admin's id.
