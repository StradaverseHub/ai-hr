# Dedicated customer / UAT installation. Never copy development or demo env files.
# Deployment identity only: 0600, outside the web user's readable paths.
# The web service receives a separate root-owned /etc/aihr/runtime.env WITHOUT migration credentials.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://ai_hr_app:REPLACE_WITH_APP_PASSWORD@db.customer.example:5432/ai_hr?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://ai_hr_owner:REPLACE_WITH_OWNER_PASSWORD@db.customer.example:5432/ai_hr?sslmode=verify-full
# Public DB CA installed root-owned; Node and libpq have different trust inputs.
NODE_EXTRA_CA_CERTS=/etc/ssl/certs/aihr-database-ca.pem
PGSSLROOTCERT=/etc/ssl/certs/aihr-database-ca.pem
AI_CONFIG_SECRET=REPLACE_WITH_STABLE_RANDOM_SECRET
TERAS_PROPOSAL_SECRET=REPLACE_WITH_STABLE_RANDOM_SECRET_OF_32_OR_MORE_CHARACTERS
AUDIT_HASH_CHAIN_ENABLED=true
AUTH_PROVIDER=internal
AUTH_PUBLIC_ORIGIN=https://hr.customer.example
# Optional login default. Bind this code to the exact tenant during owner enrollment.
AUTH_DEFAULT_ORGANIZATION=customer
# Generate independently: openssl rand -hex 32. Back up with the database: this encrypts
# passwords' hashes, MFA secrets, sessions and SMTP credentials. Do not casually rotate it.
AUTH_SESSION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Configure and test the installation SMTP relay through Admin → Email delivery after owner login.
# Legacy federation settings are documented separately; new installations need no identity server.
# Never set ALLOW_DEMO_SESSION, DEV_TENANT_ID or DEV_USER_ID.
# No SHARE_PASSWORD is needed with validated internal sign-in.
# PLATFORM_DATABASE_URL is privileged; add only for explicitly operated control-plane features.

# Database connection budget (db/capacity.ts). Web fleet = AIHR_APP_WORKERS x AIHR_DB_POOL_MAX, within
# AIHR_DB_TOTAL_CONNECTIONS. Every other process declares AIHR_DB_PROCESS_ROLE=worker in its systemd unit
# (default pool 2). deploy.sh refuses a deploy unless web + background + reserved fits max_connections.
# AIHR_APP_WORKERS=2
# AIHR_DB_TOTAL_CONNECTIONS=16
# AIHR_DB_POOL_MAX=8
# AIHR_DB_BACKGROUND_CONNECTIONS=16   # import worker, timers, Entra worker, report renderer
# AIHR_DB_RESERVED_CONNECTIONS=5      # migrations, backups, monitoring, operator sessions

# Background leave ledger import (bulk job plan step 1). Needs the aihr-leave-import worker unit running.
# LEAVE_IMPORT_BACKGROUND=true
