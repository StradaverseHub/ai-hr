[Unit]
Description=AI HR Entra workforce provisioning
After=network-online.target
[Service]
Type=oneshot
User=aihr
WorkingDirectory=/opt/ai-hr
EnvironmentFile=/etc/ai-hr/entra-worker.env
ExecStart=/usr/bin/node --import tsx scripts/entra/worker.ts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
