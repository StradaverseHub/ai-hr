[Unit]
Description=AI HR deployment-owned Keycloak identity
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=aihr-keycloak
Group=aihr-keycloak
WorkingDirectory=/opt/aihr-keycloak/current
EnvironmentFile=/etc/aihr-keycloak/service.env
ExecStart=/opt/aihr-keycloak/current/bin/kc.sh start --optimized
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/aihr-keycloak/current/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65536
MemoryMax=1G

[Install]
WantedBy=multi-user.target
