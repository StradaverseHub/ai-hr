# Cloudflare/tunnel upstream becomes 127.0.0.1:3001 after this configuration passes nginx -t.
# The identity service itself and its management endpoints are never exposed directly.
# Omit request URLs/query strings: callbacks and activation paths carry single-use credentials.
log_format aihr_identity_safe '$remote_addr $request_method $status $body_bytes_sent';
server {
    access_log /var/log/nginx/aihr-edge.log aihr_identity_safe;
    listen 127.0.0.1:3001;
    server_name _;
    client_max_body_size 20m;
    location = /identity { return 308 /identity/; }
    location = /identity/admin { return 404; }
    location = /identity/realms/master { return 404; }
    location /identity/admin/ { return 404; }
    location /identity/realms/master/ { return 404; }
    location = /identity/realms/ai-hr-email-test { return 404; }
    location /identity/realms/ai-hr-email-test/ { return 404; }
    location /identity/health { return 404; }
    location /identity/metrics { return 404; }
    location /identity/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host @PUBLIC_HOST@;
        proxy_set_header X-Forwarded-Host @PUBLIC_HOST@;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_hide_header Server;
        proxy_read_timeout 30s;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host @PUBLIC_HOST@;
        proxy_set_header X-Forwarded-Host @PUBLIC_HOST@;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
}
