[Unit]
Description=Prune expired private AI HR authentication records
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/aihr/auth-maintenance.pg_service.conf

[Service]
Type=oneshot
User=root
Environment=PGSERVICEFILE=/etc/aihr/auth-maintenance.pg_service.conf
ExecStart=/usr/bin/psql service=aihr_auth_maintenance -v ON_ERROR_STOP=1 -c "select app.internal_auth_prune()"
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
