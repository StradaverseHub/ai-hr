# ADR-0181 — one zero-downtime web slot. Instances: aihr-web@blue, aihr-web@green.
# Install: /etc/systemd/system/aihr-web@.service. Per slot, /etc/aihr/web-slot-<slot>.env holds PORT
# (blue 3101, green 3102 by default). deploy/zero-downtime/release-web.sh starts, stops and switches
# them; do not enable them at boot by hand (see README: boot).
#
# Derived from deploy/aihr-customer.service; the hardening, credential exclusions and environment
# check are the same. test/zero-downtime-release-web.test.ts pins that the two stay in step. What
# differs: the working directory is the slot's release (a symlink resolved at start, so repointing a
# slot never changes a running process), the cache path is that release's, and stop gives Next time
# to finish in-flight requests.
[Unit]
Description=AI HR web slot %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=aihr
Group=aihr
WorkingDirectory=/opt/aihr-web/slots/%i
EnvironmentFile=/etc/aihr/runtime.env
EnvironmentFile=/etc/aihr/web-slot-%i.env
Environment=PATH=/opt/node24/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# These credentials/identities never belong in the customer web process, even if misconfigured.
UnsetEnvironment=MIGRATION_DATABASE_URL PLATFORM_DATABASE_URL BACKUP_DATABASE_URL BACKUP_APP_DATABASE_URL REHEARSAL_DATABASE_URL REHEARSAL_APP_DATABASE_URL AIHR_IDENTITY_EMAIL_DATABASE_URL TEST_DATABASE_URL TEST_MIGRATION_DATABASE_URL PGPASSWORD ALLOW_DEMO_SESSION DEV_TENANT_ID DEV_USER_ID NODE_OPTIONS NEXT_DEPLOYMENT_ID
# Check the EFFECTIVE runtime values too; the root-owned runtime file can drift from deploy config.
ExecStartPre=/opt/node24/bin/node /opt/aihr-web/slots/%i/deploy/check-customer-env.mjs
ExecStart=/opt/node24/bin/node /opt/aihr-web/slots/%i/node_modules/next/dist/bin/next start -H 127.0.0.1 -p ${PORT}
Restart=on-failure
RestartSec=5
# SIGTERM: Next finishes in-flight requests and pending after() work, then exits. The controller only
# stops a slot after Nginx has stopped sending it new requests and a drain period has passed.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=90
UMask=0077
LimitCORE=0

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Next's image/data cache is the only persistent application write path currently required.
ReadWritePaths=/opt/aihr-web/slots/%i/.next/cache
# PID 1 reads EnvironmentFile before applying this service's filesystem restrictions.
# Next auto-loads .env files; UnsetEnvironment alone would not stop it reloading the owner password.
InaccessiblePaths=/etc/aihr -/opt/aihr-web/slots/%i/.env -/opt/aihr-web/slots/%i/.env.local -/opt/aihr-web/slots/%i/.env.production -/opt/aihr-web/slots/%i/.env.production.local

# Two slots overlap only during a switch. Each keeps the customer profile's bounds; the production
# app VM has 64 GiB, so both fit with room to spare.
MemoryHigh=10G
MemoryMax=12G
TasksMax=512

[Install]
WantedBy=multi-user.target
