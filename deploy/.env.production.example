# AI HR — production env for the gated consultant demo. Copy to `.env.production` (git-ignored) and fill in.
#
# THIS IS THE GATED CONSULTANT DEMO'S TEMPLATE, NOT A CUSTOMER'S (r290 / readiness 1.1). The three
# demo variables below — ALLOW_DEMO_SESSION, DEV_TENANT_ID, DEV_USER_ID — are what let deploy.sh run
# db/seed.ts, which TRUNCATEs 24 tables and plants a fictional "Demo Group" tenant. For a customer
# deployment copy deploy/.env.customer.example instead and deploy with ./deploy/deploy-customer.sh.
# Generate secrets with:  openssl rand -base64 32

NODE_ENV=production

# App DB role — non-privileged, RLS-enforced (this is what the running app uses):
DATABASE_URL=postgresql://ai_hr_app:CHANGE_ME_APP_PW@localhost:5432/ai_hr

# Owner role — runs migrations + seed only (used by deploy.sh, NOT the running app):
MIGRATION_DATABASE_URL=postgresql://ai_hr_owner:CHANGE_ME_OWNER_PW@localhost:5432/ai_hr

# Secret for encrypting in-app AI provider keys at rest (min 16 chars; keep stable or stored keys break):
AI_CONFIG_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Demo access gate (HTTP Basic — testers type ANY username + this password). REQUIRED in production:
SHARE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ALLOW_DEMO_SESSION=true

# Demo session identity — the seed's fixed HR Admin. Do NOT change: db/seed.ts refuses outright if
# DEV_TENANT_ID names a different tenant, because deploy.sh's "already seeded?" lookup would then
# never succeed and the TRUNCATE would run on every deploy.
DEV_TENANT_ID=11111111-1111-1111-1111-111111111111
DEV_USER_ID=22222222-2222-2222-2222-222222222222

# Port the app binds on 0.0.0.0 (open this in the server firewall):
PORT=3000
