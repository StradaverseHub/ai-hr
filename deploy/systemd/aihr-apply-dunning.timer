# Timer for the apply-dunning sweep. NOT enabled by deploy.sh — see deploy/systemd/README.md.
[Unit]
Description=AI HR sweep timer: apply-dunning (daily 04:00)

[Timer]
OnCalendar=*-*-* 04:00:00
# The box may be asleep or the service down at the scheduled minute; run on the next start instead of
# silently skipping the day. For usage-capture in particular a skipped day is unbillable forever.
Persistent=true
# Spread the load so five sweeps do not all wake on the same second.
RandomizedDelaySec=120
Unit=aihr-apply-dunning.service

[Install]
WantedBy=timers.target
