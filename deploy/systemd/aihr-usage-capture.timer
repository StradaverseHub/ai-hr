# Timer for the usage-capture sweep. NOT enabled by deploy.sh — see deploy/systemd/README.md.
[Unit]
Description=AI HR sweep timer: usage-capture (daily 01:00)

[Timer]
OnCalendar=*-*-* 01:00:00
# The box may be asleep or the service down at the scheduled minute; run on the next start instead of
# silently skipping the day. For usage-capture in particular a skipped day is unbillable forever.
Persistent=true
# Spread the load so five sweeps do not all wake on the same second.
RandomizedDelaySec=120
Unit=aihr-usage-capture.service

[Install]
WantedBy=timers.target
