# Timer for the expire-aged-leave sweep. NOT enabled by deploy.sh — see deploy/systemd/README.md.
[Unit]
Description=AI HR sweep timer: expire-aged-leave (daily 03:10)

[Timer]
OnCalendar=*-*-* 03:10:00
# The box may be asleep or the service down at the scheduled minute; run on the next start instead of
# silently skipping the day. For usage-capture in particular a skipped day is unbillable forever.
Persistent=true
# Spread the load so five sweeps do not all wake on the same second.
RandomizedDelaySec=120
Unit=aihr-expire-aged-leave.service

[Install]
WantedBy=timers.target
