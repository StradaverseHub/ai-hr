# EAS archives from the Git root, even when invoked from mobile/.
# Only the native app and its shared contracts belong in that archive.
/*
!/.easignore
!/mobile
!/lib
/lib/*
!/lib/bounded-body.ts
!/lib/clock-attempt.ts
!/lib/mobile-clock-integrity.ts
!/lib/mobile-key-enrollment.ts
!/lib/mobile-integrity-contract.ts
!/lib/mobile-connection.ts
!/lib/mobile-workplace-setup.ts
!/lib/mobile-design.ts
!/lib/mobile-composition.ts
!/lib/mobile-api
/lib/mobile-api/*
!/lib/mobile-api/contract.ts

# EAS replaces .gitignore when this file exists; repeat private/generated exclusions.
**/node_modules
**/.expo
**/dist
/mobile/android
/mobile/ios
/mobile/modules/**/android/build
/mobile/modules/**/android/.gradle
/mobile/modules/**/ios/build
**/.env*
**/*.pem
**/*.key
**/*.p8
**/*.jks
**/*.keystore
**/*.p12
**/*.mobileprovision
**/credentials.json
/mobile/builds
**/*.tsbuildinfo
**/.DS_Store
