          "title": "Open an available review unit",
          "body": "Choose a unit you can access. Inspect its employee facts, policy and proposed changes before deciding or returning work.",
          "lang": "en"
        },
        "roles": [
          "manager",
          "hr_admin",
          "super_admin"
        ]
      },
      {
        "id": "3",
        "route": "/rewards",
        "target": null,
        "placement": "center",
        "text": {
          "title": "Verify the next state",
          "body": "After an authorized decision, check the unit’s resulting stage and outstanding reviewers. Approval does not itself post a payroll payment.",
          "lang": "en"
        },
        "roles": [
          "manager",
          "hr_admin",
          "super_admin"
        ]
      }
    ]
  },
  "intelligence": {
    "id": "intelligence",
    "steps": [
      {
        "id": "1",
        "route": "/control-tower",
        "target": "[data-tour=\"intelligence-control-tower\"]",
        "placement": "bottom",
        "text": {
          "title": "Review operational evidence",
          "body": "Use Control Tower to inspect readiness and exceptions. Check the underlying facts before accepting an explanation or action.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      },
      {
        "id": "2",
        "route": "/assistant",
        "target": "[data-tour=\"intelligence-assistant\"]",
        "placement": "bottom",
        "text": {
          "title": "Use the assistant with context",
          "body": "Ask about a specific company, employee or period. Review cited records and proposals; AI inherits your access and does not replace payroll calculations or human decisions.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      },
      {
        "id": "3",
        "route": "/reports",
        "target": "[data-tour=\"intelligence-reports\"]",
        "placement": "bottom",
        "text": {
          "title": "Check a report before sharing",
          "body": "Choose the relevant report and verify its filters, population and totals. An export does not establish that an external submission was accepted.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      }
    ]
  },
  "mobileDesign": {
    "id": "mobileDesign",
    "steps": [
      {
        "id": "1",
        "route": "/mobile-preview",
        "target": null,
        "placement": "center",
        "text": {
          "title": "Design the tenant’s mobile experience",
          "body": "Group administrators edit this design. Preview interactions demonstrate presentation; use the explicitly labelled live experience only for real HR actions.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      },
      {
        "id": "2",
        "route": "/mobile-preview",
        "target": "[data-tour=\"mobile-navigation\"]",
        "placement": "bottom",
        "text": {
          "title": "Choose a screen or section",
          "body": "Use the navigator to select the supported screen and composition. Changing presentation does not grant modules or permissions.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      },
      {
        "id": "3",
        "route": "/mobile-preview",
        "target": "[data-tour=\"mobile-design\"]",
        "placement": "bottom",
        "text": {
          "title": "Review design and history",
          "body": "Use the inspector for branding, typography, colours and supported layouts. Review appearance and release history before publication.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      },
