  "attendanceCalculation": {
    "id": "attendanceCalculation",
    "steps": [
      {
        "id": "1",
        "route": "/admin/attendance/settings",
        "target": null,
        "placement": "center",
        "text": {
          "title": "Trace an attendance result",
          "body": "Check the employee and date first. The roster, backup shift and company schedule can produce different expected hours.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      },
      {
        "id": "2",
        "route": "/admin/attendance/settings",
        "target": "[data-tour=\"attendance-configuration\"]",
        "placement": "bottom",
        "text": {
          "title": "Review the schedule configuration",
          "body": "Use these settings to inspect shifts, schedules, breaks, file mappings and locations. Review the effective assignment before changing a result.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      },
      {
        "id": "3",
        "route": "/attendance",
        "target": "[data-tour=\"attendance-summary\"]",
        "placement": "bottom",
        "text": {
          "title": "Check the calculated attendance",
          "body": "Compare raw punches, leave and holidays with the calculated day. Use an authorized correction or recompute, then review payroll separately.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      }
    ]
  },
  "claimsEmployee": {
    "id": "claimsEmployee",
    "steps": [
      {
        "id": "1",
        "route": "/claims",
        "target": null,
        "placement": "center",
        "text": {
          "title": "Submit an expense claim",
          "body": "Start with the correct claim type and date. A saved draft has not yet been submitted for approval.",
          "lang": "en"
        }
      },
      {
        "id": "2",
        "route": "/claims",
        "target": "[data-tour=\"claims-compose\"]",
        "placement": "bottom",
        "text": {
          "title": "Prepare the claim",
          "body": "Enter the amount and required details, attach receipts where required, and review the applicable limit. Save a draft or submit when ready.",
          "lang": "en"
        }
      },
      {
        "id": "3",
        "route": "/claims",
        "target": "[data-tour=\"claims-history\"]",
        "placement": "bottom",
        "text": {
          "title": "Track the result",
          "body": "Review submitted claims and their statuses here. Approval and reimbursement are separate stages; an approved claim does not prove payment.",
          "lang": "en"
        }
      }
    ]
  },
