        "id": "4",
        "route": "/mobile-preview",
        "target": "[data-tour=\"mobile-publication\"]",
        "placement": "bottom",
        "text": {
          "title": "Save before publishing",
          "body": "Save the draft, review the published preview, then deliberately publish. A revision conflict needs a refresh and reconciliation; publication does not distribute an app-store binary.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      }
    ]
  },
  "notifications": {
    "id": "notifications",
    "steps": [
      {
        "id": "1",
        "route": "/notices",
        "target": "[data-tour=\"notices-mine\"]",
        "placement": "bottom",
        "text": {
          "title": "Read notices intended for you",
          "body": "Open a notice to read its content and complete any required acknowledgement. The list reflects your audience and publication window.",
          "lang": "en"
        }
      },
      {
        "id": "2",
        "route": "/me/notifications",
        "target": "[data-tour=\"notification-consent\"]",
        "placement": "bottom",
        "text": {
          "title": "Choose workflow email preferences",
          "body": "Email needs enabled tenant categories, your explicit consent and a ready installation relay. Review the verified identity requirement and choose preferences for the correct employment.",
          "lang": "en"
        }
      },
      {
        "id": "3",
        "route": "/me/notifications",
        "target": null,
        "placement": "center",
        "text": {
          "title": "Confirm saved preferences",
          "body": "Choose your email language and save when ready. Saving preferences does not replay historical notifications or prove that an email arrived.",
          "lang": "en"
        }
      }
    ]
  },
  "communications": {
    "id": "communications",
    "steps": [
      {
        "id": "1",
        "route": "/admin/notice-board",
        "target": "[data-tour=\"notices-administration\"]",
        "placement": "bottom",
        "text": {
          "title": "Manage company notices",
          "body": "Review the audience, publication dates and acknowledgement requirement before publishing. Check the resulting status and intended recipients.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      },
      {
        "id": "2",
        "route": "/knowledge-base",
        "target": "[data-tour=\"knowledge-base-library\"]",
        "placement": "bottom",
        "text": {
          "title": "Publish company knowledge",
          "body": "Add company policies as separate articles or uploads. System guides are release-managed; each guide’s walkthrough explains the relevant screens.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      },
      {
        "id": "3",
        "route": "/admin/settings/notifications",
        "target": "[data-tour=\"workflow-email-readiness\"]",
        "placement": "bottom",
        "text": {
          "title": "Check email readiness",
          "body": "Relay readiness, tenant policy and recipient consent are separate prerequisites. An inactive relay or missing installation upgrade needs the installation maintainer.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      },
      {
        "id": "4",
        "route": "/admin/settings/notifications",
        "target": "[data-tour=\"workflow-email-policy\"]",
        "placement": "bottom",
        "text": {
          "title": "Review category policy",
          "body": "Group administrators can enable categories here. Enabling applies to future events; it does not grant recipient consent or send a historical backlog.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      },
      {
        "id": "5",
        "route": "/admin/settings/notifications",
        "target": "[data-tour=\"workflow-email-deliveries\"]",
        "placement": "bottom",
        "text": {
          "title": "Inspect delivery outcomes",
          "body": "Review status and attempts before retrying a failure. Sent means relay acceptance, not inbox delivery or human reading.",
          "lang": "en"
        },
        "roles": [
          "hr_admin",
          "super_admin"
        ]
      }
    ]
  },
  "operatorProvisioning": {
