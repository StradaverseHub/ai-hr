        },
        "roles": [
          "operator"
        ]
      },
      {
        "id": "3",
        "route": "/operator",
        "target": "[data-tour=\"operator-requests\"]",
        "placement": "bottom",
        "text": {
          "title": "Follow the runner outcome",
          "body": "Pending and Running are not completed customers. Review the failed step before retrying; a retry preserves the original request history.",
          "lang": "en"
        },
        "roles": [
          "operator"
        ]
      },
      {
        "id": "4",
        "route": "/operator",
        "target": null,
        "placement": "center",
        "text": {
          "title": "Deliver activation deliberately",
          "body": "After Done, reveal the activation link only when ready to deliver it privately. A consumed reveal cannot be recovered by refreshing; request reissue when needed.",
          "lang": "en"
        },
        "roles": [
          "operator"
        ]
      }
    ]
  },
