    "steps": [
      {
        "id": "1",
        "route": "/operator",
        "target": null,
        "placement": "center",
        "text": {
          "title": "Provision a customer",
          "body": "Confirm the customer, initial administrator, country and purchased modules. Operator access and customer HR administration are separate capabilities.",
          "lang": "en"
        },
        "roles": [
          "operator"
        ]
      },
      {
        "id": "2",
        "route": "/operator",
        "target": "[data-tour=\"operator-customer-form\"]",
        "placement": "bottom",
