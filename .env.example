# Copy to .env.local and adjust. Local dev uses a dedicated PG14 cluster on port 5433.
#
# App runtime: connect as a NON-privileged role so RLS is enforced (ADR-0002).
DATABASE_URL=postgres://ai_hr_app@127.0.0.1:5433/ai_hr_dev
# Migrations/admin: the owner role.
MIGRATION_DATABASE_URL=postgres://postgres@127.0.0.1:5433/ai_hr_dev
# Tests.
TEST_DATABASE_URL=postgres://ai_hr_app@127.0.0.1:5433/ai_hr_test
TEST_MIGRATION_DATABASE_URL=postgres://postgres@127.0.0.1:5433/ai_hr_test

# Dev session (seeded by `pnpm db:seed`) — dev only; replaced by WorkOS later.
DEV_TENANT_ID=11111111-1111-1111-1111-111111111111
DEV_USER_ID=22222222-2222-2222-2222-222222222222

# AI gateway (ADR-0007 / ADR-0023) — OPTIONAL. Powers "Draft with AI" on the manager review.
# Draft-only, human-in-the-loop; never writes a rating or pay. With nothing configured the feature is
# simply hidden (graceful degradation) — the app needs no key to run.
#
# Per-tenant config is set in-app at /admin/ai (provider + model + API key, encrypted at rest). The
# vars below are the PLATFORM fallback used when a tenant has not configured its own provider.
#
# AI_CONFIG_SECRET — REQUIRED to store tenant keys in-app. Master passphrase (>=16 chars) that
# AES-256-GCM-encrypts keys at rest (tenant id as AAD). Without it, in-app key storage is disabled
# (the env keys below still work). Rotating it makes existing stored keys unrecoverable — re-enter them.
# AI_CONFIG_SECRET=change-me-to-a-long-random-string
#
# Platform fallback provider keys — any one enables drafting tenant-wide without in-app config:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...                # or GEMINI_API_KEY (Gemini Developer API)
# AI_DRAFT_MODEL=claude-opus-4-8    # optional: override the Anthropic env-fallback model
