+ AND app.contract_shared_worker_event_held(p_case,(f.data->'decision'->>'revision')::integer)
+ AND EXISTS(SELECT 1 FROM jsonb_array_elements(v.definition->'steps') s WHERE s->>'id'=p_step AND s->>'type'=p_type))
