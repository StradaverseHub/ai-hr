        "sha256": "9ead5dfa7bb1b8adc657a5e7d9993b29170eb8d546875dacef6ffc92c3769aa8"
      },
      "inverseHunks": [
        {
          "currentStart": 53110,
          "currentEnd": 53219,
          "currentRangeSha256": "8e39440ad4444d796330852687e7d5df252c9a78be76720929947b86f0f4b948",
          "parentStart": 53110,
          "parentEnd": 53301,
          "parentText": "/** One dated native population for complete export and paged presentation. */\nfunction carryForwardPopulationTx(tx:Tx,scopeIds:string[]|undefined,p:CarryForwardInput,selectedIds?:string[]){\n"
        },
        {
          "currentStart": 53282,
          "currentEnd": 53914,
          "currentRangeSha256": "5c62de418add69d54c3ace01ec31880e91e3f90d19488aabaac0ffc5a2361b49",
          "parentStart": 53364,
          "parentEnd": 53364,
          "parentText": ""
        },
        {
          "currentStart": 54515,
          "currentEnd": 54612,
          "currentRangeSha256": "e7e49ebeec396b70df0ad0364e745d9e703e64c873b152f9b2ceaac05911008a",
          "parentStart": 53965,
          "parentEnd": 54473,
          "parentText": "      .where(\n        and(\n          scopeWhere(scopeIds),\n          selectedIds ? inArray(employment.id,selectedIds) : undefined,\n          p.companyId ? eq(employment.companyId, p.companyId) : undefined,\n          p.filter?.departmentId ? eq(assignment.departmentId, p.filter.departmentId) : undefined,\n          qWhere(p.filter),\n          lte(employment.hiredOn, yearEnd),\n          or(isNull(employment.terminatedOn), gte(employment.terminatedOn, yearStart)),\n        ),\n      ).orderBy(employment.id);\n"
        },
        {
          "currentStart": 54973,
          "currentEnd": 55146,
          "currentRangeSha256": "52970c73d822049939877049084467fa57f6fc04f00a03d887465cdce3a99483",
          "parentStart": 54834,
          "parentEnd": 55004,
          "parentText": " * Identity sorting is intentionally O(population) minimal names/IDs, not a claim\n * of fully bounded native collation. Expensive ledger/template reads are page-only. */\n"
        },
        {
          "currentStart": 55571,
          "currentEnd": 57018,
          "currentRangeSha256": "a2d114323c6fca5d51bc4f4a2d5e6dcd4c745411e95b2af9e482ce5864d13c1b",
          "parentStart": 55429,
          "parentEnd": 55429,
          "parentText": ""
        },
        {
          "currentStart": 57357,
          "currentEnd": 58162,
          "currentRangeSha256": "3cb83057a66e97cf0959bdbc9b7bff560728a25c78ee4054a9e7abd75d22b18a",
          "parentStart": 55768,
          "parentEnd": 55925,
          "parentText": "    const population=carryForwardPopulationTx(tx,scope,input).as('analytics_carry_population');\n    const identities:{employmentId:string;name:string}[]=[];\n"
        },
        {
          "currentStart": 58405,
          "currentEnd": 58799,
          "currentRangeSha256": "175616b3a4b7bdc19002c423da3f3cee8a508daa087c6f80ce9ace3ba7fc3c5a",
          "parentStart": 56168,
          "parentEnd": 56361,
          "parentText": "      const batch=await tx.execute<{employmentId:string;name:string}>(sql`fetch forward 512 from analytics_carry_identities`);\n      identities.push(...batch);\n      if(batch.length<512)break;\n"
        },
        {
          "currentStart": 59109,
          "currentEnd": 59238,
          "currentRangeSha256": "e28809f5844e9d6a8b5fa5c2fc8e1bf9e70fb4dc3d974192458093421c0f0e00",
          "parentStart": 56671,
          "parentEnd": 56829,
          "parentText": "    identities.sort((a,b)=>a.name.localeCompare(b.name));\n    const selected=identities.slice(page.offset,page.offset+page.limit).map(row=>row.employmentId);\n"
        },
        {
          "currentStart": 59323,
          "currentEnd": 59382,
          "currentRangeSha256": "32c91403e3a3c50766c4ff55f8bcecba9aaf580547870b5bb630ae29f19e7761",
          "parentStart": 56914,
          "parentEnd": 56985,
          "parentText": "    return {rows,state:pageState(page,identities.length,rows.length)};\n"
        }
      ]
    },
