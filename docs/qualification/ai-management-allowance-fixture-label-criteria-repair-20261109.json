    "cause": "The other-company assignment used departmentB with only original-company nonGlobal Criteria.0550 checks coalesce(assignment.company_id,employment.company_id) without an owner bypass, so constructing that assignment would violate the existing deferred constraint. Source inference only, no runtime result.",
    "originalFindingAndFrozenSourcePreserved": true
  },
  "repair": {
    "changedHelper": "roster",
    "canonicalCall": "setLabelCriteria(group,{kind:'department',labelId:b.deptB,isGlobal:false,companyIds:[b.companyId,other.id]})",
    "order": "After other company creation, before c assignment construction.",
    "canonicalNativeGuardsLocksValidationAuditWhole": true,
    "storedCriteriaOracle": {
      "isGlobal": false,
      "companyIds": "exactly sorted [b.companyId,other.id], from stored department/label_company_assignment rows, not writer return"
    },
    "storedAssignmentOracle": {
      "companyId": "other.id, computed coalesce(assignment.company_id,employment.company_id)",
      "departmentId": "b.deptB",
      "recordIdentity": "c.assignmentId and c.employmentId in current tenant"
    },
    "directCriteriaWritesOrConstraintBypass": false,
    "fixtureWholeInverse": {
      "deleteExactlySixAddedLines": [
        "import {setLabelCriteria} from '../core/system-labels';\n",
        " await setLabelCriteria(group,{kind:'department',labelId:b.deptB,isGlobal:false,companyIds:[b.companyId,other.id]});\n",
        " const criteria=await owner.client<{isGlobal:boolean;companyIds:string[]}[]>`select d.is_global as \"isGlobal\",array(select lca.company_id::text from public.label_company_assignment lca where lca.tenant_id=d.tenant_id and lca.label_kind='department' and lca.label_id=d.id order by lca.company_id) as \"companyIds\" from public.department d where d.tenant_id=${b.tenantId}::uuid and d.id=${b.deptB}::uuid`;\n",
        " expect(criteria).toEqual([{isGlobal:false,companyIds:[b.companyId,other.id].sort()}]);\n",
        " const assigned=await owner.client<{companyId:string;departmentId:string}[]>`select coalesce(a.company_id,e.company_id)::text as \"companyId\",a.department_id::text as \"departmentId\" from public.assignment a join public.employment e on e.id=a.employment_id and e.tenant_id=a.tenant_id where a.tenant_id=${b.tenantId}::uuid and a.id=${c.assignmentId}::uuid and e.id=${c.employmentId}::uuid`;\n",
        " expect(assigned).toEqual([{companyId:other.id,departmentId:b.deptB}]);\n"
      ]
    },
    "allOriginalFixtureBytesRestoredByInverse": true
  },
