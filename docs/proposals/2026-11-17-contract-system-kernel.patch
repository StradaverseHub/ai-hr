+/** Fixed allowlist: declaring a handler flag on another kind grants it nothing. */
+async function processContractSystemClaimed(connection:postgres.ReservedSql,handler:BulkJobHandler,c:Claimed,unit:BulkJobUnit){
+ const job=c.job;
+ if(!['contract_schedule','contract_scheduled_automation'].includes(job.kind)||!handler.systemOwner||!handler.prepareSystem||!handler.finalizeSystem||!handler.finalizeOwner)
+  return failJob(connection,handler,c,null,'This system job has no authorized owner.',[],new BulkJobConfigurationError('Invalid system job kind.'));
+ const systemUnit:BulkJobDiscardUnit={metric:unit.metric,set:unit.set,step:async()=>{throw new BulkJobConfigurationError('System jobs have no app-role steps.');},verifySeal:unit.verifySeal,
+  ownerTx:fn=>ownerTransaction(connection,c,'system',async owner=>{
+   await owner`select set_config('app.tenant_id',${job.tenant_id},true),set_config('app.user_id','',true),set_config('jit','off',true)`;
+   const [held]=await owner<{ok:boolean}[]>`select app.contract_shared_system_job_held(${job.id}::uuid) as ok`;
+   if(!held?.ok)throw new BulkJobAuthorityLost();
+   return fn(owner);
+  })};
+ // Required final implementation: owner-only queued -> preparing -> finalizing state transitions, sealed plan,
+ // bounded finalizeSystem calls, existing transient backoff/failure records, and quiet owner-only terminal cleanup.
+ // Every systemUnit.ownerTx must validate provenance/source as well as the existing kernel lease capability.
+}
