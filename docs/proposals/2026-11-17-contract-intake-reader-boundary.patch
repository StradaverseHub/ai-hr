+  EXISTS(SELECT 1 FROM people_ops) AND EXISTS(SELECT 1 FROM roles r WHERE r.company_id=e.company_id AND r.role='gbs' AND (r.business_unit_id IS NULL OR r.business_unit_id=e.business_unit_id))
