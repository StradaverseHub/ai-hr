      "refersTo": "button-primary",
      "description": "Shared operational primary action, Atelier light preview.",
      "html": "<button class=\"ds-primary\">Save appearance</button>",
      "css": ".ds-primary{font-family:var(--font-sans,system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;min-height:2rem;padding:.5rem 1rem;border:0;border-radius:.5rem;background:var(--primary,#c2410c);color:var(--primary-foreground,#fff);font-size:.875rem;font-weight:500;box-shadow:0 1px 2px rgb(20 20 30 / .05);transition:background 150ms,transform 150ms cubic-bezier(.23,1,.32,1)}.ds-primary:hover:not(:disabled){background:var(--atelier-accent-hover,#a8380a)}.ds-primary:focus-visible{outline:2px solid var(--ring,#c2410c);outline-offset:2px;}.ds-primary:active{transform:scale(.98)}.ds-primary:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;transform:none}}"
