      "css": ".ds-rail{background:var(--sidebar,#f8f8f9);padding:.5rem}.ds-nav{font-family:var(--font-sans,system-ui,sans-serif);display:flex;align-items:center;gap:.625rem;min-height:1.875rem;padding:0 .5rem;border-radius:.375rem;color:var(--sidebar-foreground,#4b4b52);font-size:.84375rem;text-decoration:none}.ds-nav:hover{background:var(--accent,#efeff1);color:var(--foreground,#1c1c1f)}.ds-nav[aria-current=\"page\"]{background:#e9e9ec;color:var(--foreground,#1c1c1f);font-weight:500}.ds-nav:focus-visible{outline:2px solid var(--ring,#c2410c);outline-offset:2px;}"
    },
    {
      "name": "Suggestion chip",
      "kind": "chip",
      "refersTo": "suggestion",
      "description": "Neutral Home suggestion; no primary fill.",
      "html": "<button class=\"ds-suggestion\">Review my tasks</button>",
      "css": ".ds-suggestion{font-family:var(--font-sans,system-ui,sans-serif);height:1.875rem;padding:0 .75rem;border:1px solid var(--border,#e8e8eb);border-radius:999px;background:var(--card,#fff);color:var(--sidebar-foreground,#4b4b52);font-size:.8125rem;transition:background 150ms,color 150ms}.ds-suggestion:hover{background:var(--sidebar,#f8f8f9);color:var(--foreground,#1c1c1f)}.ds-suggestion:focus-visible{outline:2px solid var(--ring,#c2410c);outline-offset:2px;}@media(prefers-reduced-motion:reduce){.ds-suggestion{transition:none}}"
    },
    {
      "name": "Operational card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat card with the shared sentence-case header strip.",
      "html": "<section class=\"ds-card\"><header class=\"ds-card-head\">Welcome media</header><div class=\"ds-card-body\">Choose the image, GIF or video shown before sign-in.</div></section>",
      "css": ".ds-card{font-family:var(--font-sans,system-ui,sans-serif);border:1px solid var(--border,#e8e8eb);border-radius:.75rem;background:var(--card,#fff);color:var(--foreground,#1c1c1f);box-shadow:none}.ds-card-head{padding:.75rem 1rem;border-bottom:1px solid var(--border,#e8e8eb);border-radius:.6875rem .6875rem 0 0;background:var(--sidebar,#f8f8f9);font-size:.8125rem;font-weight:600}.ds-card-body{padding:1rem;font-size:.875rem;line-height:1.25rem}"
    },
    {
      "name": "Editorial Continue",
      "kind": "button",
      "refersTo": "login-continue",
      "description": "Public workspace-step arrow; disabled until code is nonempty.",
      "html": "<button class=\"ds-login-continue\" aria-label=\"Continue\"><svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></button>",
      "css": ".ds-login-continue{display:grid;place-items:center;width:3.0625rem;height:3.0625rem;border:0;border-radius:50%;background:#2b2944;color:#fff;cursor:pointer;transition:background-color 140ms ease}.ds-login-continue:hover:not(:disabled){background:#47415d}.ds-login-continue:focus-visible{outline:2px solid #7764c2;outline-offset:4px}.ds-login-continue:active:not(:disabled){transform:translateY(1px)}.ds-login-continue:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-login-continue{transition:none}.ds-login-continue:active:not(:disabled){transform:none}}"
