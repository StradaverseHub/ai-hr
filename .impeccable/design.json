  "narrative": {
    "northStar": "Atelier / Maker's Mark",
    "overview": "Atelier is the default authenticated workspace: neutral surfaces, compact controls, a quiet navigation rail and fire-orange actions. The existing Maker's Mark supplies its signature. This records the implemented system alongside the supported Classic and Monolith choices; light/dark remains an independent setting.\n\nPublic sign-in is a distinct, owner-specified indigo-and-white surface with AIHR identity. Its palette is scoped locally and remains light across app themes. Its typography resolves the existing font variable. The login composition belongs to its surface brief, not to every future screen.",
    "keyCharacteristics": [
      "Flat shell and cards with hairline boundaries.",
      "Compact sentence-case operational hierarchy.",
      "Orange action/focus accent in Atelier; independent indigo sign-in.",
      "Human-confirmation signature and semantic status labels."
    ],
    "rules": [
      {
        "name": "The Scoped Accent Rule",
        "body": "Use Atelier orange for actions, focus and small emphasis; keep public sign-in indigo inside its own surface.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Keep the shell and cards flat; use the existing small control shadow, ask-box lift and overlay shadow for their established roles.",
        "section": "elevation"
      }
