      "html": "<label class=\"ds-login-workspace\">Workspace code<span class=\"ds-login-entry\"><input placeholder=\"Your workspace code\" autocomplete=\"organization\"></span></label>",
      "css": ".ds-login-workspace{display:flex;flex-direction:column;gap:.875rem;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:.8125rem;font-weight:600;color:#2b2944}.ds-login-entry{display:flex;padding-bottom:1rem;border-bottom:1px solid #858497}.ds-login-workspace input{width:100%;height:3.0625rem;padding:0;border:0;border-radius:0;background:transparent;color:#2b2944;font:inherit;font-size:1.4375rem;font-weight:400}.ds-login-workspace input::placeholder{color:#737184;opacity:1}.ds-login-workspace input:focus-visible{outline:2px solid #7764c2;outline-offset:4px}"
