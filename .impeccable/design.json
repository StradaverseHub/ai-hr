      "css": ".ds-field{font-family:var(--font-sans,system-ui,sans-serif);display:flex;flex-direction:column;gap:.375rem;color:var(--muted-foreground,#5f5f67);font-size:.75rem;font-weight:500}.ds-input{font-family:var(--font-sans,system-ui,sans-serif);height:2.25rem;padding:.25rem .75rem;border:1px solid var(--atelier-line-strong,#dcdce0);border-radius:.5rem;background:var(--card,#fff);color:var(--foreground,#1c1c1f);font-size:.875rem;box-shadow:0 1px 2px rgb(20 20 30 / .05);outline:none}.ds-input::placeholder{color:var(--muted-foreground,#5f5f67)}.ds-input:focus-visible{border-color:var(--primary,#c2410c);box-shadow:0 0 0 3px color-mix(in srgb,var(--primary,#c2410c) 18%,transparent)}.ds-input:disabled{cursor:not-allowed;opacity:.5}"
