# Copy to .env.local (gitignored). Neither value is a secret: the client id is public by design (PKCE).
# HTTPS origin only, e.g. https://sfm.stradaprop.com. Local development also requires TLS.
EXPO_PUBLIC_API_URL=
# WorkOS client id of the environment to sign in against (Staging for development).
EXPO_PUBLIC_WORKOS_CLIENT_ID=

# Keycloak (public configuration only; never put a client secret in the app)
EXPO_PUBLIC_AUTH_PROVIDER=keycloak
EXPO_PUBLIC_KEYCLOAK_ISSUER=https://hr.example.com/identity/realms/ai-hr
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=aihr-mobile
