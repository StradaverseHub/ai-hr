{
  "cli": {
    "version": ">= 24.10.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_RUNTIME_CONNECTIONS": "1",
        "EXPO_PUBLIC_AUTH_PROVIDER": "internal"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "latest"
      }
    },
    "android-local-signing": {
      "extends": "preview",
      "withoutCredentials": true,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true,
        "image": "latest"
      }
    }
  }
}
