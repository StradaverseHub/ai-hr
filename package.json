{
  "name": "ai-hr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "host": "bash scripts/host.sh",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dom": "vitest run --project dom",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "gate:cleanroom": "bash cleanroom-verify.sh",
    "gate:shadow": "bash scripts/shadow-migrate.sh",
    "gate:fresh": "bash scripts/fresh-migrate.sh",
    "db:start": "/opt/homebrew/opt/postgresql@16/bin/pg_ctl -D /opt/homebrew/var/aihr-pg16 -o '-p 5433 -k /tmp' -l /tmp/aihr-pg16.log start",
    "db:stop": "/opt/homebrew/opt/postgresql@16/bin/pg_ctl -D /opt/homebrew/var/aihr-pg16 stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file=.env.local --import tsx db/seed.ts",
    "dev:fixture-pooled-leave": "node --env-file=.env.local --import tsx scripts/dev-fixture-pooled-leave.ts",
    "dev:fixture-pcb-detail": "node --env-file=.env.local --import tsx scripts/dev-fixture-pcb-detail.ts",
    "leave:accrue": "node --env-file=.env.local --import tsx scripts/accrue-earned.ts",
    "leave:expire-carry": "node --env-file=.env.local --import tsx scripts/expire-carry.ts",
    "review:sweep": "node --env-file=.env.local --import tsx scripts/review-sweep.ts",
    "usage:capture": "node --env-file=.env.local --import tsx scripts/capture-usage.ts",
    "feedback:plan": "node --env-file=.env.local --import tsx scripts/feedback-plan.ts",
    "improve:pull": "node --import tsx scripts/improve/cli.ts pull",
    "improve:status": "node --import tsx scripts/improve/cli.ts status",
    "improve:raise": "node --import tsx scripts/improve/cli.ts raise",
    "improve:pull-item": "node --import tsx scripts/improve/cli.ts pull-item",
    "improve:pull-approved": "node --import tsx scripts/improve/cli.ts pull-approved",
    "improve:pull-planned": "node --import tsx scripts/improve/cli.ts pull-planned",
    "improve:pull-blocked": "node --import tsx scripts/improve/cli.ts pull-blocked",
    "improve:attachments": "node --import tsx scripts/improve/cli.ts attachments",
    "improve:block": "node --import tsx scripts/improve/cli.ts block",
    "improve:unblock": "node --import tsx scripts/improve/cli.ts unblock",
    "improve:push-plan": "node --import tsx scripts/improve/cli.ts push-plan",
    "mockup": "node --import tsx scripts/mockup/render.ts",
    "improve:build-start": "node --import tsx scripts/improve/cli.ts build-start",
    "improve:build-complete": "node --import tsx scripts/improve/cli.ts build-complete",
    "improve:release": "node --import tsx scripts/improve/cli.ts release",
    "improve:deploy": "node --import tsx scripts/improve/cli.ts deploy",
    "improve:mark-deployed": "node --import tsx scripts/improve/cli.ts mark-deployed",
    "kb:seed": "node --env-file=.env.local --import tsx db/seed-guides.ts",
    "db:studio": "drizzle-kit studio",
    "i18n:export": "node --import tsx scripts/i18n-export.ts",
    "i18n:import": "node --import tsx scripts/i18n-import.ts",
    "statutory:build-my": "node --env-file=.env.local --import tsx scripts/statutory-pack-build-my.ts",
    "statutory:sync": "node --env-file=.env.local --import tsx scripts/statutory-sync.ts",
    "seed:catalogs": "node --env-file=.env.local --import tsx scripts/seed-catalogs.ts",
    "claims:backfill-mileage-rate": "node --env-file=.env.local --import tsx scripts/backfill-mileage-flat-rate.ts",
    "platform:usage": "node --env-file=.env.local --import tsx scripts/platform-usage-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@workos-inc/authkit-nextjs": "^4.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fontkit": "^1.9.0",
    "leaflet": "1.9.4",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "openai": "^6.43.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "^2.0.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.1.8",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
