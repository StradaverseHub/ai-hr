import labels from './labels.json';
import {doubled} from './math.js';
import type {ExternalContext} from 'fixture-external';
export type SessionContext={tenantId:string;entitlements?:Record<string,boolean>};
export const employment={id:'fictional-employment'};
type Tx={select<T extends Record<string,unknown>>(selection:T):{from:(table:typeof employment)=>Promise<T[]>}};
export async function withTenant<T>(_ctx:SessionContext,read:(tx:Tx)=>Promise<T>):Promise<T>{return read({select(selection){return{from:async()=>[selection]};}});}
export async function readEmployeeChoices(_ctx:SessionContext):Promise<{rows:Array<{status:'active'|'ended'}>}>{return{rows:[{status:'active'}]};}
export function translate(key:keyof typeof labels):string{return labels[key];}
export type OriginalJsonContext=typeof labels;
export type OriginalAmbientContext=CompilerReferenceAmbient;
export type OriginalExternalContext=ExternalContext;
export const amount:number=doubled(7);
